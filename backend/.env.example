# Database connection string (or use individual variables below)
DATABASE_URL=postgres://user:password@localhost:5432/globetrotter

# Alternative database connection variables
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=globetrotter
PGPORT=5432

# Authentication
JWT_SECRET=your_super_secret_jwt_key

# Server Port
PORT=5000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
